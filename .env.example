# Copy to .env for local use (never commit .env). On Vercel, set these in
# Project -> Settings -> Environment Variables instead. All are optional.

# Hosted LLMs (any one is enough; the offline mock models need no key).
# Visitors can also enter their own keys on the dashboard's "API keys" page; a key set here is used
# for every visitor who has not, and billed to you. Leave these empty if everyone brings their own.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Model ids offered in the dashboard's "Record a run" picker on Vercel
# BLACKBOX_GEMINI_MODEL=gemini-2.5-flash
# BLACKBOX_GROQ_MODEL=llama-3.3-70b-versatile
# Or set the whole list yourself (comma-separated):
# BLACKBOX_MODELS=mock-large,mock-small,gemini:gemini-2.5-flash

# Let an LLM write the "Why did it fail?" explanation (e.g. gemini:gemini-2.5-flash)
# BLACKBOX_EXPLAIN_LLM=

# Custom runs: set to 0 to turn off Wikidata / World Bank / Wikipedia lookups
# BLACKBOX_WEB_SEARCH=1
